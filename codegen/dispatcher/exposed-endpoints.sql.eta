-- Gate-exposed paths for the <%= it.dispatcher.name %> project dispatcher (ADR 012). Generated by Code Control.
-- The project dispatcher only forwards these rows; the main gateway reaches them at /<%= it.dispatcher.project_id %>/<path>.
-- The table normally comes from migration 002; it is created here too for repos made before it existed.
CREATE TABLE IF NOT EXISTS dispatcher_exposed_endpoints (
  id text PRIMARY KEY,
  project_id text NOT NULL,
  service_id text NOT NULL,
  method text NOT NULL CHECK (method IN ('GET', 'POST', 'PUT', 'PATCH', 'DELETE')),
  path text NOT NULL,
  summary text NOT NULL DEFAULT '',
  requires_body boolean NOT NULL DEFAULT false,
  enabled boolean NOT NULL DEFAULT true,
  sort_order integer NOT NULL DEFAULT 0,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  UNIQUE (project_id, method, path)
);

CREATE INDEX IF NOT EXISTS idx_dispatcher_exposed_endpoints_project_enabled
  ON dispatcher_exposed_endpoints (project_id, enabled);

CREATE INDEX IF NOT EXISTS idx_dispatcher_exposed_endpoints_path
  ON dispatcher_exposed_endpoints (path);

INSERT INTO dispatcher_exposed_endpoints (id, project_id, service_id, method, path, summary, requires_body, enabled, sort_order) VALUES
<% it.dispatcher.endpoints.forEach((endpoint, index) => { -%>
  (<%~ it.h.sqlQuote(endpoint.id) %>, <%~ it.h.sqlQuote(it.dispatcher.project_id) %>, <%~ it.h.sqlQuote(endpoint.service_id) %>, <%~ it.h.sqlQuote(endpoint.method) %>, <%~ it.h.sqlQuote(endpoint.path) %>, <%~ it.h.sqlQuote(endpoint.summary) %>, <%= endpoint.requires_body %>, true, <%= endpoint.sort_order %>)<%= index === it.dispatcher.endpoints.length - 1 ? '' : ',' %>
<% }) -%>
ON CONFLICT DO NOTHING;
