<%
/* CREATE TABLE IF NOT EXISTS + indexes. Standard columns: id first, the rest (timestamps) last. No functions or triggers. */
const ON_DELETE = { none: '', cascade: ' ON DELETE CASCADE', set_null: ' ON DELETE SET NULL', restrict: ' ON DELETE RESTRICT' };
const safeDefault = (value) => (value.includes(';') ? '' : value.trim());
const columnLine = (column) => {
  const parts = [column.name, column.sql_type];
  if (column.not_null) parts.push('NOT NULL');
  const defaultSql = safeDefault(column.default_sql);
  if (defaultSql) parts.push(`DEFAULT ${defaultSql}`);
  if (column.is_unique) parts.push('UNIQUE');
  if (column.enum_values.length > 0) {
    parts.push(`CHECK (${column.name} IN (${column.enum_values.map((value) => it.h.sqlQuote(value)).join(', ')}))`);
  }
  if (column.references_table) parts.push(`REFERENCES ${column.references_table} (id)${ON_DELETE[column.on_delete]}`);
  return parts.join(' ');
};
const leading = it.standard_columns.filter((column) => column.name === 'id').map((column) => column.sql_definition);
const trailing = it.standard_columns.filter((column) => column.name !== 'id').map((column) => column.sql_definition);
const lines = [...leading, ...it.columns.map(columnLine), ...trailing];
const indexes = it.columns
  .filter((column) => column.is_indexed && !column.is_unique)
  .map((column) => `CREATE INDEX IF NOT EXISTS ${it.h.indexName(it.table.name, column.name)} ON ${it.table.name} (${column.name});`);
-%>
-- <%= it.table.name %>: <%= it.h.oneLine(it.table.purpose) %>
-- Generated by Code Control from data model v<%= it.version %> (archetype: <%= it.table.archetype %>, lifecycle: <%= it.table.lifecycle %>).
-- updated_at is set by data-layer CRUD; no SQL functions or triggers.
CREATE TABLE IF NOT EXISTS <%= it.table.name %> (
<%= lines.map((line) => `  ${line}`).join(',\n') %>
);
<% if (indexes.length > 0) { -%>

<%= indexes.join('\n') %>
<% } -%>
