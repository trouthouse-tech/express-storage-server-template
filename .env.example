PORT=3080
NODE_ENV=development
# Loopback by default; the project dispatcher proxies to it.
STORAGE_BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://localhost:5432/your_project
PG_POOL_MAX=10
# Required for every /api/storage route except /health (sent as x-storage-secret).
STORAGE_DISPATCHER_SECRET=
STORAGE_SERVICE_NAME=your-project-storage
