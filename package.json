{
  "name": "express-storage-server-template",
  "version": "1.0.0",
  "description": "Storage Express template: owns Postgres, migrations and CRUD; serves POST /api/storage/v1/invoke",
  "main": "index.ts",
  "scripts": {
    "start": "ts-node index.ts",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "db:apply-migrations": "ts-node scripts/apply-migrations.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.11",
    "@types/pg": "^8.23.1"
  },
  "engines": {
    "node": "22.x"
  }
}
